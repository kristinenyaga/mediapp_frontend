{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "app/components/patient/doctors/Doctors.jsx", "app/components/patient/doctors/DoctorCard.jsx", "app/components/admin/users/AddDoctors.jsx", "app/components/admin/users/DoctorFilters.jsx", "app/components/authentication/ForgotPassword.jsx", "app/components/authentication/Otp.jsx", "app/components/authentication/ResetPassword.jsx", "app/components/authentication/SignIn.jsx", "app/components/authentication/SignUp.jsx"],
  "exclude": ["node_modules"]
}
